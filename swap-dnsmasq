#!/bin/bash
# swap-dnsmasq — switch between the distro-packaged dnsmasq.service and
# the patched /usr/local/sbin/dnsmasq built from this repo. The local
# build runs as a transient systemd unit (dnsmasq-local.service)
# launched with the same argv as dnsmasq.service, so config + pidfile +
# user/group all match.
#
# Usage:
#   sudo ./swap-dnsmasq local     # stop system service, run /usr/local one
#   sudo ./swap-dnsmasq system    # stop /usr/local one, restart system
#   sudo ./swap-dnsmasq status    # which is running, plus binary versions
#
# 'local' also points systemd-resolved at this dnsmasq, and 'system' puts
# resolved back. Rationale: /etc/resolv.conf is a symlink into
# /run/systemd/resolve/ which resolved regenerates, so editing it to give
# dnsmasq upstreams never sticks. Inverting the chain instead - resolved as a
# stub that forwards to dnsmasq - leaves resolv.conf alone entirely and gives
# the whole box one cache that can see the fleet's own zone.
# Set NETMGR_WIRE_RESOLVED=0 to skip that part and only swap binaries.

set -eu

# Where the event socket listens. 0.0.0.0 was the old default and on a gateway
# that puts the DHCP/DNS control channel on the WAN, reachable from the
# Internet. Bind a private address instead: nas3 still reaches it across the
# LAN, which is the only thing that needs to. NETMGR_EVENT_LISTEN overrides.
# The fallback is loopback rather than every interface - if no private address
# can be found, failing closed is the safer wrong answer.
if [ -z "${NETMGR_EVENT_LISTEN:-}" ]; then
    _priv=$(ip -4 -o addr show scope global 2>/dev/null \
            | awk '{print $4}' | cut -d/ -f1 \
            | grep -E '^(10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.)' \
            | head -1)
    EVENT_LISTEN="${_priv:-127.0.0.1}:7533"
else
    EVENT_LISTEN="$NETMGR_EVENT_LISTEN"
fi

LOCAL_BIN=/usr/local/sbin/dnsmasq
SYSTEM_BIN=/usr/sbin/dnsmasq
LOCAL_UNIT=dnsmasq-local

# A drop-in, never an edit of resolved.conf: undoing it is a delete, so 'system'
# cannot leave a half-restored resolver behind. DNSStubListener is deliberately
# NOT set here - /etc/resolv.conf points at 127.0.0.53, so the stub has to stay.
RESOLVED_DROPIN=/etc/systemd/resolved.conf.d/50-netmgr-dnsmasq.conf
# Which links we cleared a '~.' from, so 'system' can put them back. Runtime
# state in /run, because the clearing itself is runtime-only (DHCP restores the
# '~.' on the next lease anyway).
RESOLVED_STATE=/run/swap-dnsmasq/cleared-domains
WIRE_RESOLVED="${NETMGR_WIRE_RESOLVED:-1}"

# Read the running dnsmasq's actual argv from /proc so we run the
# local build with the same flags. We can't trust dnsmasq.service's
# ExecStart= because Debian/Ubuntu wrap dnsmasq behind /etc/init.d
# (ExecStart points at a shell script that builds the real argv).
# If dnsmasq isn't currently running, fall back to a sensible default.
running_argv() {
    local pid args
    for pid in $(pgrep -x dnsmasq 2>/dev/null); do
        args=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)
        # Match a /usr/sbin/dnsmasq instance; ignore any other dnsmasq
        # processes (e.g. our /usr/local one if it's already started).
        case "$args" in
            /usr/sbin/dnsmasq*) echo "$args"; return ;;
        esac
    done
    # already-local: no packaged instance is running because OURS is. Re-running
    # 'local' is a legitimate restart (net-mgr drives it that way), and falling
    # through to the hardcoded default would silently drop the real argv - the
    # DNSSEC --trust-anchor= pair, --dhcp-reply-delay, whatever the host had. So
    # read our own cmdline instead and strip the two flags this script adds, or
    # they would be passed twice.
    for pid in $(pgrep -f "^$LOCAL_BIN" 2>/dev/null); do
        args=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)
        case "$args" in
            "$LOCAL_BIN"*)
                # Re-head it as the system binary so the caller's "drop the
                # first token" step still means the same thing.
                set -- $args
                shift
                filtered=
                for a in "$@"; do
                    case "$a" in
                        --keep-in-foreground|--event-listen=*) ;;
                        *) filtered="$filtered $a" ;;
                    esac
                done
                echo "$SYSTEM_BIN$filtered"
                return ;;
        esac
    done
    echo "/usr/sbin/dnsmasq -x /run/dnsmasq/dnsmasq.pid"\
         "-u dnsmasq -7 /etc/dnsmasq.d,.dpkg-dist,.dpkg-old,.dpkg-new"\
         "--local-service"
}

# Is systemd-resolved actually the resolver here? Several nodes do not run it,
# and on those this whole section must be a no-op rather than an error.
resolved_in_use() {
    [ "$WIRE_RESOLVED" = 1 ] || return 1
    command -v resolvectl >/dev/null 2>&1 || return 1
    [ "$(systemctl is-active systemd-resolved 2>/dev/null)" = active ] || return 1
    return 0
}

# Links holding the '~.' catch-all. Such a link beats the Global scope for EVERY
# name, so leaving one in place means resolved never reaches the DNS= we set and
# the wiring silently does nothing. Seen live on gateway3: the Yeacomm LTE link
# held '~.' and every query went to a dead LTE resolver while the configured
# Comcast pair sat unused in Global.
resolved_catchall_links() {
    resolvectl domain 2>/dev/null |
      awk '/^Link/ && /~\./ { name=$3; gsub(/[():]/, "", name); print name }'
}

# A link's FULL domain list, tab-separated from its name. A link normally
# carries more than the catch-all - 'Link 3 (wlp0s12f0): ~. hsd1.ca.comcast.net'
# is the ordinary DHCP-fed shape - so putting back a bare '~.' later would
# silently drop the search domain. Record everything, restore exactly that.
resolved_link_domains() {
    resolvectl domain 2>/dev/null |
      awk '/^Link/ && /~\./ {
             name = $3; gsub(/[():]/, "", name);
             doms = "";
             for (i = 4; i <= NF; i++) doms = doms (doms == "" ? "" : " ") $i;
             print name "\t" doms
           }'
}

# THE LOOP GUARD. dnsmasq's default resolv-file is /etc/resolv.conf, which on a
# resolved box resolves to the stub - so a freshly started dnsmasq's only
# upstream is 127.0.0.53, i.e. resolved. Pointing resolved back at dnsmasq then
# builds dnsmasq -> resolved -> dnsmasq and every query hangs. Only wire once
# dnsmasq holds an upstream that is not the stub (the net-mgr resolvers feed, or
# no-resolv + server= lines). Failing closed here leaves resolved untouched,
# which is the safe wrong answer.
dnsmasq_has_real_upstream() {
    command -v dig >/dev/null 2>&1 || return 1
    local out
    out=$(dig +short +time=2 +tries=1 chaos txt servers.bind @127.0.0.1 2>/dev/null) || return 1
    [ -n "$out" ] || return 1
    # Every upstream is the stub or ourselves => nothing real to forward to.
    printf '%s\n' "$out" | tr -d '"' | tr ' ' '\n' |
      grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+#' |
      grep -qvE '^(127\.0\.0\.53|127\.0\.0\.1)#'
}

resolved_wire() {
    resolved_in_use || { echo "resolved: not in use here — left alone"; return 0; }

    if ! dnsmasq_has_real_upstream; then
        echo "resolved: NOT wired — dnsmasq has no upstream except the resolved stub." >&2
        echo "  Wiring now would loop (dnsmasq -> resolved -> dnsmasq) and hang every" >&2
        echo "  query. Give dnsmasq real resolvers first (net-mgr resolvers feed, or" >&2
        echo "  no-resolv + server= lines), then re-run: $0 local" >&2
        return 0
    fi

    mkdir -p "$(dirname "$RESOLVED_DROPIN")" "$(dirname "$RESOLVED_STATE")"
    cat > "$RESOLVED_DROPIN" <<EOF
# Written by swap-dnsmasq. Points systemd-resolved at the patched dnsmasq on
# this host so the whole box resolves through one cache and can see the fleet's
# own zone, instead of resolv.conf being fought over.
#
# resolv.conf is left alone on purpose: it is a symlink into
# /run/systemd/resolve/ that resolved regenerates. DNSStubListener is NOT set
# here - the symlink points at 127.0.0.53, so the stub must keep listening.
#
# Remove this file (or run 'swap-dnsmasq system') and restart
# systemd-resolved to undo.
[Resolve]
DNS=127.0.0.1
Domains=~.
EOF

    # Clear any link-level '~.' at runtime, recording what we touched. Runtime
    # only: making it persistent means editing a NetworkManager profile, which
    # is a different subsystem and not this script's business to mutate - the
    # command is printed instead.
    : > "$RESOLVED_STATE"
    local cleared=0 l doms
    while IFS=$'\t' read -r l doms; do
        [ -n "$l" ] || continue
        resolvectl domain "$l" "" 2>/dev/null || continue
        printf '%s\t%s\n' "$l" "$doms" >> "$RESOLVED_STATE"
        cleared=$((cleared + 1))
        echo "resolved: cleared domains '$doms' from link $l (runtime only)"
        echo "  to persist: nmcli con mod <profile-on-$l> ipv4.ignore-auto-dns yes ipv6.ignore-auto-dns yes"
    done <<EOF
$(resolved_link_domains)
EOF
    [ "$cleared" = 0 ] || true

    systemctl restart systemd-resolved 2>/dev/null || true
    echo "resolved: now forwarding to 127.0.0.1 (this dnsmasq) via $RESOLVED_DROPIN"
}

resolved_unwire() {
    resolved_in_use || return 0
    local changed=0
    if [ -e "$RESOLVED_DROPIN" ]; then
        rm -f "$RESOLVED_DROPIN"
        changed=1
        echo "resolved: removed $RESOLVED_DROPIN"
    fi
    # Put back any '~.' we cleared, so leaving the patched build restores the
    # resolver layout we found rather than a third state nobody chose.
    if [ -s "$RESOLVED_STATE" ]; then
        local l doms
        while IFS=$'\t' read -r l doms; do
            [ -n "$l" ] || continue
            # shellcheck disable=SC2086 -- $doms is a deliberate word list
            resolvectl domain "$l" $doms 2>/dev/null \
              && echo "resolved: restored domains '$doms' on link $l" || true
        done < "$RESOLVED_STATE"
        rm -f "$RESOLVED_STATE"
        changed=1
    fi
    [ "$changed" = 0 ] || systemctl restart systemd-resolved 2>/dev/null || true
}

cmd="${1:-status}"

case "$cmd" in
  local)
    [ "$(id -u)" -eq 0 ] || { echo "must be root" >&2; exit 1; }
    [ -x "$LOCAL_BIN" ] || {
        echo "no $LOCAL_BIN — run 'make install' in this repo first" >&2
        exit 1
    }
    # Capture argv BEFORE we stop the system service, so /proc still
    # has the running process to read from.
    argv=$(running_argv)
    [ -n "$argv" ] || {
        echo "couldn't determine system dnsmasq argv" >&2
        exit 1
    }
    # First token is the original binary path; drop it, keep the rest.
    # Filter out --trust-anchor=... / --dnssec* if our local build was
    # compiled without HAVE_DNSSEC — those would be rejected as
    # "unsupported option" and the daemon would refuse to start.
    set -- $argv
    shift
    if "$LOCAL_BIN" --version 2>&1 | grep -q 'no-DNSSEC'; then
        filtered=
        for a in "$@"; do
            case "$a" in
                --trust-anchor=*|--dnssec*) ;;
                *) filtered="$filtered $a" ;;
            esac
        done
        # shellcheck disable=SC2086
        set -- $filtered
    fi
    systemctl stop dnsmasq.service 2>/dev/null || true
    # MASK it, do not merely stop it. Stopping is not enough because the packaged
    # unit gets started behind our back by two routine things:
    #
    #   * an apt upgrade of the dnsmasq package. Its postinst chooses restart vs
    #     start on whether /run/dnsmasq/dnsmasq.pid exists - and OUR instance
    #     wrote that pidfile, so it takes the restart branch and aims
    #     /etc/init.d/dnsmasq's stop at it:
    #        start-stop-daemon --stop --retry=TERM/30/KILL/5 \
    #            --pidfile /run/dnsmasq/${NAME}.pid --name ${NAME}
    #     Our process's comm is 'dnsmasq' and that is its pidfile, so the upgrade
    #     KILLS the patched build. It runs as a systemd-run --collect transient
    #     unit with no Restart=, so the unit is then garbage-collected and
    #     nothing brings DNS or DHCP back.
    #   * a reboot, since the unit stays enabled.
    #
    # Masking survives the postinst: deb-systemd-helper's unmask only removes a
    # mask it created itself (it requires its own state file under
    # /var/lib/systemd/deb-systemd-helper-masked/), and an admin 'systemctl mask'
    # never creates one. 'system' unmasks again.
    if systemctl mask dnsmasq.service >/dev/null 2>&1; then
        echo "masked dnsmasq.service — a package upgrade or reboot can no longer start it"
    else
        echo "WARNING: could not mask dnsmasq.service; an apt upgrade of the dnsmasq" >&2
        echo "  package may kill this instance (it targets our pidfile by name)." >&2
    fi
    # Also stop a PREVIOUS instance of our own transient unit. Without this a
    # re-run dies on "unit dnsmasq-local.service already exists", which makes
    # the swap unusable as a restart - and restarting is the only way to pick up
    # a dnsmasq.conf change, since dnsmasq re-reads hosts and resolv-file on
    # SIGHUP but never its configuration.
    systemctl stop "$LOCAL_UNIT.service" 2>/dev/null || true
    # Wait for the pid file to be released (dnsmasq holds it until exit).
    for _ in 1 2 3 4 5; do
        [ -e /run/dnsmasq/dnsmasq.pid ] || break
        sleep 0.2
    done
    # Run with --keep-in-foreground so systemd's simple-service watcher
    # tracks the process correctly. Without it dnsmasq daemonises and
    # systemd-run thinks the unit died immediately.
    systemd-run \
        --unit="$LOCAL_UNIT" \
        --description="patched dnsmasq from /usr/local (swap-dnsmasq)" \
        --collect \
        "$LOCAL_BIN" --keep-in-foreground --event-listen="$EVENT_LISTEN" "$@"
    echo "started $LOCAL_UNIT — event-socket at $EVENT_LISTEN"
    # Give the new instance a moment to bind and load its servers before the
    # loop guard interrogates it, or a healthy setup looks unwired.
    sleep 2
    resolved_wire
    ;;

  system)
    [ "$(id -u)" -eq 0 ] || { echo "must be root" >&2; exit 1; }
    # Unwire BEFORE the patched instance goes away: while resolved still points
    # at 127.0.0.1, a dnsmasq-shaped hole there is a resolution outage for the
    # whole box, including anything this script might want to look up.
    resolved_unwire
    systemctl stop "$LOCAL_UNIT.service" 2>/dev/null || true
    # Unmask unconditionally: 'local' masks it, and a masked unit cannot be
    # started at all, so without this the swap back is a no-op that leaves the
    # host with no dnsmasq. Unconditional rather than "only if we masked it" -
    # asking for the packaged server IS asking for it to be startable, so an
    # operator's own earlier mask is superseded by this explicit request.
    if systemctl unmask dnsmasq.service >/dev/null 2>&1; then
        echo "unmasked dnsmasq.service"
    fi
    systemctl start dnsmasq.service
    echo "started dnsmasq.service"
    ;;

  status)
    for u in dnsmasq.service "$LOCAL_UNIT.service"; do
        s=$(systemctl is-active "$u" 2>&1 || true)
        printf "%-25s %s\n" "$u" "$s"
    done
    [ -x "$SYSTEM_BIN" ] && \
        echo "$SYSTEM_BIN: $($SYSTEM_BIN --version 2>&1 | head -1)"
    [ -x "$LOCAL_BIN" ] && \
        echo "$LOCAL_BIN: $($LOCAL_BIN --version 2>&1 | head -1)"
    _m=$(systemctl is-enabled dnsmasq.service 2>&1 || true)
    printf "%-25s %s\n" "dnsmasq.service state" \
        "$_m$([ "$_m" = masked ] && echo '  (packaged unit cannot start — correct while on local)')"
    if [ -e "$RESOLVED_DROPIN" ]; then
        printf "%-25s %s\n" "resolved->dnsmasq" "wired ($RESOLVED_DROPIN)"
    else
        printf "%-25s %s\n" "resolved->dnsmasq" "not wired"
    fi
    if command -v resolvectl >/dev/null 2>&1; then
        _cc=$(resolved_catchall_links | tr '\n' ' ')
        [ -z "$_cc" ] || printf "%-25s %s\n" "links holding '~.'" \
            "$_cc  (these beat Global and defeat the wiring)"
    fi
    ;;

  *)
    echo "usage: $0 local|system|status" >&2
    exit 2
    ;;
esac
